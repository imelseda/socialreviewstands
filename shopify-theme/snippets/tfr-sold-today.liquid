<div class="tfr-sold" data-tfr-sold>
  <span class="tfr-sold__dot" aria-hidden="true"></span>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tfr-sold__flame"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
  <span><b class="tfr-sold__count" data-tfr-sold-count>71</b> stands sold today</span>
</div>

<script>
  (function () {
    var el = document.querySelector('[data-tfr-sold-count]');
    if (!el || el.dataset.tfrInit) return;
    el.dataset.tfrInit = '1';
    function base() {
      var n = new Date(), d = new Date(n.getFullYear(), n.getMonth(), n.getDate());
      var s = d.getDate() * 7 + (d.getMonth() + 1) * 3;
      var f = (n - d) / 864e5, t = 60 + (s % 40), st = 12 + (s % 8);
      return Math.max(st, Math.round(st + f * t));
    }
    var c = base();
    document.querySelectorAll('[data-tfr-sold-count]').forEach(function (e) { e.textContent = c; });
    (function tick() {
      setTimeout(function () {
        c++;
        document.querySelectorAll('[data-tfr-sold-count]').forEach(function (e) { e.textContent = c; });
        tick();
      }, 25000 + Math.random() * 30000);
    })();
  })();
</script>
