<section class="tfr-order" id="order">
  <div class="tfr-inner tfr-split">
    <div>
      <p class="tfr-eyebrow">Get yours</p>
      <h2 class="tfr-h2">Stop losing reviews. <span class="tfr-gold">Start collecting them.</span></h2>
      <p class="tfr-lead">Your competitors are collecting 5-star reviews right now. Grab your stand below — or send us a note and we'll reply within 24 hours.</p>
      <a href="{{ section.settings.product_link | default: routes.all_products_collection_url }}" class="tfr-btn-gold tfr-order__buy">Buy Now — Free Shipping</a>
      {% render 'tfr-sold-today' %}
      <ul class="tfr-bullets tfr-order__perks">
        <li><span class="tfr-bullet"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v8H3zM14 10h4l3 3v2h-7z"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg></span>Fast tracked shipping — buyers report 7–9 day delivery</li>
        <li><span class="tfr-bullet"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.5-2 8-6.5 8-11V5l-8-3-8 3v6c0 4.5 2.5 9 8 11z"/><path d="m9 12 2 2 4-4"/></svg></span>90-day money-back guarantee, no questions asked</li>
        <li><span class="tfr-bullet"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m5 5 14 14"/></svg></span>One-time purchase — no subscription, no monthly fees</li>
      </ul>
    </div>

    <div class="tfr-formcard">
      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <p class="tfr-formcard__success">Request received! We'll reply within 24 hours with pricing and delivery details.</p>
        {% endif %}
        {{ form.errors | default_errors }}
        <div class="tfr-formcard__row">
          <div class="tfr-field">
            <label for="tfr-name">Your name *</label>
            <input class="tfr-input" id="tfr-name" type="text" name="contact[name]" required placeholder="Alex Meyer">
          </div>
          <div class="tfr-field">
            <label for="tfr-email">Email *</label>
            <input class="tfr-input" id="tfr-email" type="email" name="contact[email]" required placeholder="alex@yourbusiness.com">
          </div>
        </div>
        <div class="tfr-field">
          <label for="tfr-business">Business name</label>
          <input class="tfr-input" id="tfr-business" type="text" name="contact[business]" placeholder="Your café, salon or store">
        </div>
        <div class="tfr-formcard__row">
          <div class="tfr-field">
            <label for="tfr-variant">Style *</label>
            <select class="tfr-input" id="tfr-variant" name="contact[style]">
              <option>Style A · Obsidian Black</option>
              <option>Style A · Pearl White</option>
              <option>Style B · Noir Black</option>
              <option>Style B · Boutique White</option>
            </select>
          </div>
          <div class="tfr-field">
            <label for="tfr-qty">Quantity *</label>
            <input class="tfr-input" id="tfr-qty" type="number" name="contact[quantity]" min="1" max="500" value="1" required>
          </div>
        </div>
        <div class="tfr-field">
          <label for="tfr-msg">Message</label>
          <textarea class="tfr-input" id="tfr-msg" name="contact[body]" rows="4" placeholder="Platform you want to link, delivery country, questions…"></textarea>
        </div>
        <button type="submit" class="tfr-btn-gold tfr-btn-gold--full">Reserve My Stand</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TFR Order",
  "settings": [
    { "type": "url", "id": "product_link", "label": "Buy button link (your product page)" }
  ],
  "presets": [{ "name": "TFR Order" }]
}
{% endschema %}
