<header class="tfr-header" data-testid="site-header">
  <nav class="tfr-header__nav">
    <a href="{{ routes.root_url }}" class="tfr-header__logo" aria-label="{{ shop.name }}">
      <span class="tfr-header__mark">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 8.5a6 6 0 0 1 12 0"/><path d="M3.5 6a11 11 0 0 1 17 0"/><path d="M8.5 11a3 3 0 0 1 7 0"/><circle cx="12" cy="13.5" r="1.4" fill="currentColor"/></svg>
      </span>
      {{ shop.name | default: 'TapFive Review' }}
    </a>
    <div class="tfr-header__links">
      <a href="{{ routes.root_url }}#problem">The Problem</a>
      <a href="{{ routes.root_url }}#how-it-works">How It Works</a>
      <a href="{{ routes.root_url }}#variants">Styles</a>
      <a href="{{ routes.root_url }}#reviews">Reviews</a>
      <a href="{{ routes.root_url }}#faq">FAQ</a>
      <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="tfr-btn-gold tfr-btn-gold--sm">{{ section.settings.cta_label }}</a>
    </div>
    <button class="tfr-header__burger" aria-label="Toggle menu" onclick="document.body.classList.toggle('tfr-nav-open')">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </nav>
  <div class="tfr-header__mobile">
    <a href="{{ routes.root_url }}#problem">The Problem</a>
    <a href="{{ routes.root_url }}#how-it-works">How It Works</a>
    <a href="{{ routes.root_url }}#variants">Styles</a>
    <a href="{{ routes.root_url }}#reviews">Reviews</a>
    <a href="{{ routes.root_url }}#faq">FAQ</a>
    <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="tfr-btn-gold tfr-btn-gold--sm">{{ section.settings.cta_label }}</a>
  </div>
</header>

{% schema %}
{
  "name": "TFR Header",
  "settings": [
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Get Your Stand" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ]
}
{% endschema %}
