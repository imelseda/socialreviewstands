<section class="tfr-product">
  <div class="tfr-inner tfr-split">
    <div class="tfr-frame">
      {% if product.featured_image %}
        {{ product.featured_image | image_url: width: 1600 | image_tag: alt: product.title, class: 'tfr-media' }}
      {% endif %}
    </div>
    <div>
      <p class="tfr-eyebrow">Model 215 · NFC + QR Google Review Stand</p>
      <h1 class="tfr-h2">{{ product.title }}</h1>
      <p class="tfr-product__price">
        {% assign v = product.selected_or_first_available_variant %}
        {{ v.price | money }}
        {% if v.compare_at_price > v.price %}<s>{{ v.compare_at_price | money }}</s>{% endif %}
      </p>
      <p class="tfr-lead">{{ product.description | strip_html | truncate: 220 }}</p>

      {% form 'product', product, class: 'tfr-product__form' %}
        {% unless product.has_only_default_variant %}
          <div class="tfr-variants__options tfr-product__variants">
            {% for variant in product.variants %}
              <label class="tfr-variants__option{% if variant == product.selected_or_first_available_variant %} is-active{% endif %}">
                <input type="radio" name="id" value="{{ variant.id }}"{% if variant == product.selected_or_first_available_variant %} checked{% endif %}{% unless variant.available %} disabled{% endunless %}>
                <span>{{ variant.title }}</span>
              </label>
            {% endfor %}
          </div>
        {% else %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {% endunless %}
        <div class="tfr-field tfr-product__qty">
          <label for="tfr-product-qty">Quantity</label>
          <input class="tfr-input" id="tfr-product-qty" type="number" name="quantity" value="1" min="1">
        </div>
        <button type="submit" class="tfr-btn-gold tfr-btn-gold--full">Add to cart — free shipping</button>
      {% endform %}

      <ul class="tfr-bullets tfr-order__perks">
        <li><span class="tfr-bullet"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.5-2 8-6.5 8-11V5l-8-3-8 3v6c0 4.5 2.5 9 8 11z"/><path d="m9 12 2 2 4-4"/></svg></span>90-day money-back guarantee</li>
        <li><span class="tfr-bullet"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v8H3zM14 10h4l3 3v2h-7z"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg></span>Fast tracked shipping — 7–9 days</li>
        <li><span class="tfr-bullet"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 8.5a6 6 0 0 1 12 0"/><path d="M3.5 6a11 11 0 0 1 17 0"/><path d="M8.5 11a3 3 0 0 1 7 0"/><circle cx="12" cy="13.5" r="1.4" fill="currentColor"/></svg></span>NFC tap + QR scan — works with every phone</li>
      </ul>
    </div>
  </div>
</section>

<script>
  (function () {
    document.querySelectorAll('.tfr-product__variants .tfr-variants__option input').forEach(function (input) {
      input.addEventListener('change', function () {
        document.querySelectorAll('.tfr-product__variants .tfr-variants__option').forEach(function (l) { l.classList.remove('is-active'); });
        input.closest('.tfr-variants__option').classList.add('is-active');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "TFR Product",
  "settings": []
}
{% endschema %}
